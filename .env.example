# Copy this file to `.env.local` and adjust the value if your API runs elsewhere.
# Vite exposes only variables prefixed with VITE_ to the browser.
# Every VITE_* value is public and embedded in the client bundle. Never put secrets here.

# Base URL of the Price Tracker API, including the version prefix.
# Default used by the application when this variable is not set:
VITE_API_BASE_URL=http://localhost:8000/api/v1
