# Normalize text files to LF and keep common binary assets untouched.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
package-lock.json text eol=lf
